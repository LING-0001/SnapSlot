{
  "extends": "../website/tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [],
    "paths": {
      "@/*": ["../website/*"],
      "react": ["../website/node_modules/@types/react"],
      "react/*": ["../website/node_modules/@types/react/*"],
      "react-dom/*": ["../website/node_modules/@types/react-dom/*"]
    },
    "typeRoots": ["../website/node_modules/@types"]
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["node_modules"]
}
