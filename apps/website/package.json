{
  "name": "snapslot-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node ../../scripts/verify-release.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:downloads": "node --test checks/downloads.test.mjs",
    "build:native": "node ../native-ui/build.mjs",
    "readme:media": "node scripts/readme-media.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
