{
  "name": "snapslot-website",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4325",
    "prebuild": "node ../../scripts/prepare-website.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:downloads": "node --test checks/downloads.test.mjs",
    "build:native": "node ../native-ui/build.mjs",
    "readme:media": "node scripts/readme-media.mjs",
    "test:public": "node ../../scripts/check-public-boundary.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@linglinglab/web-ui": "file:vendor/npm/linglinglab-web-ui-1.3.1.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
